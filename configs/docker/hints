docker compose restart frontend
docker compose up --build backend

# Builder
docker build -f ./configs/docker/builder.dockerfile -t builder .

# DB
docker run -d --rm \
  --name blog_postgres \
  -e POSTGRES_PASSWORD=test \
  -e POSTGRES_USER=test \
  -e POSTGRES_DB=blog_db \
  -p 5432:5432 \
  --network blog_network \
  postgres

psql postgresql://test:test@0.0.0.0:5432/blog_db

# BE
docker build -f ./configs/docker/backend.dockerfile -t backend .

docker run --rm -it \
  --env-file=.env \
  --network blog_network \
  --name blog_backend \
  -p 8080:8080 \
  backend:latest

# FE
docker build -f ./configs/docker/frontend.dockerfile -t frontend .

docker run --rm -it \
  --network blog_network \
  --name blog_frontend \
  -p 3030:80 \
  frontend:latest

# FE binded
docker run -dit \
  --mount type=bind,source="$(pwd)"/target/dx/blog-fe/release/web/public,target=/usr/share/nginx/html \
  -p 3000:80 nginx:latest

# Systemctl
Start/Stop postgresql instance to no conflict with Docker container
sudo systemctl status postgresql
sudo systemctl start postgresql
sudo systemctl stop postgresql

# compose
docker compose --env-file .env --file ./docker-compose.yml up
docker compose --env-file .env --file ./docker-compose.yml up --build

# debug compose
docker compose exec backend curl -f http://localhost:8080/api/v0/health
docker exec -it video_processing_app bash

# Compose stats

docker stats blog_frontend blog_backend blog_postgres  --format "table {{.Name}}\t{{.MemUsage}}\t{{.MemPerc}}"
docker stats blog_frontend blog_backend blog_postgres
