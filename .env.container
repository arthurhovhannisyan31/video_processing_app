# ssh server
IMAGE_TAG=latest

# database
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=video_processing_app
POSTGRES_HOST=db
POSTGRES_PORT=5432

# server
BACKEND_HOST=0.0.0.0
BACKEND_HTTP_PORT=8081
BACKEND_JWT_SECRET=hello_kitty
BACKEND_CORS_ORIGINS=http://localhost:3000,https://www.videoprocessing.app,http://videoprocessing.local
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"
BACKEND_DB_MAX_CONNECTIONS=20
# 20 mb
BACKEND_VIDEO_MAX_BODY_SIZE=10485760
# Because GovernorConfigBuilder uses seconds for its base time period replenishment definition,
#you divide the total seconds in an hour (3600) by your target request volume (100).
#This means the limiter should replenish 1 element every 36
BACKEND_VIDEO_RATE_LIMIT_PERIOD_SEC=36
BACKEND_VIDEO_RATE_LIMIT_SIZE=100

#common
IS_PRODUCTION=false