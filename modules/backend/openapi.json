{
  "openapi": "3.1.0",
  "info": {
    "title": "Video processing API specification",
    "description": "Video processing application",
    "contact": {
      "name": "Arthur Hovhannisyan",
      "email": "arthurhovhannisyan31@gmail.com"
    },
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "User not found or credentials are invalid"
          },
          "500": {
            "description": "Server internal error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [],
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Credentials requirements are not met",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Server internal error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/openapi": {
      "get": {
        "tags": [],
        "operationId": "openapi",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/video/inspect": {
      "post": {
        "tags": [],
        "operationId": "inspect_video",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/InspectVideoPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Server internal error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/video/jobs": {
      "post": {
        "tags": [],
        "operationId": "process_video",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ProcessVideoPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Server internal error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "base64",
            "example": "test@test.com",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "format": "base64",
            "example": "Testtest1!",
            "maxLength": 100,
            "minLength": 8
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "token",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AuthenticatedUser"
          }
        }
      },
      "AuthenticatedUser": {
        "type": "object",
        "required": [
          "email",
          "user_id",
          "username"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "description": "CreateUserRequest requirements\n\nUsername:\n- Length 8-255 characters\n- Only alfa-numeric characters\n\nEmail:\n- length at most 255 characters\n- should match `email` regex\n\nPassword:\n- length 8-100 characters\n- Include 1 uppercase letter: A-Z\n- Include 1 lowercase letter: a-z\n- Include 1 numeric character: 0-9\n- Include a special character: !,$,#,%, etc",
        "required": [
          "username",
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "base64",
            "example": "test@test.com",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "format": "base64",
            "example": "Testtest1!",
            "maxLength": 100,
            "minLength": 8
          },
          "username": {
            "type": "string",
            "format": "base64",
            "example": "testtest",
            "maxLength": 255,
            "minLength": 8
          }
        }
      },
      "InspectVideoPayload": {
        "type": "object",
        "required": [
          "video"
        ],
        "properties": {
          "video": {
            "type": "string",
            "format": "binary"
          }
        }
      },
      "ProcessVideoPayload": {
        "type": "object",
        "required": [
          "operation",
          "video"
        ],
        "properties": {
          "operation": {
            "type": "string"
          },
          "video": {
            "type": "string",
            "format": "binary"
          }
        }
      }
    }
  }
}